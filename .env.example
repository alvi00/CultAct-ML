# Copy to .env and fill in. .env is gitignored - never commit real keys.

# CraftX OpenAI-compatible gateway (Stage 2 step2 refinement; Stage 3 agents)
CRAFTX_BASE_URL=https://your-craftx-gateway/v1
CRAFTX_API_KEY=your-craftx-key
CRAFTX_MODEL=your-refiner-model-id

# Google Cloud Translation API (Stage 2 step1 MT)
GOOGLE_TRANSLATE_API_KEY=your-google-translate-key
